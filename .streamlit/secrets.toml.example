# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Cloud
# app settings under "Secrets". Every key is optional — the app runs with none
# of them set, it just can't tell you anything about who's using it.

# --- Pageview analytics: pick one -------------------------------------------

# GoatCounter (free, no account cost, simplest to start with).
# Sign up at goatcounter.com, then put your site code here.
# GOATCOUNTER_CODE = "vcplaybook"

# Plausible.
# PLAUSIBLE_DOMAIN = "vcplaybook.com"

# Self-hosted Umami.
# UMAMI_URL = "https://analytics.example.com"
# UMAMI_WEBSITE_ID = "00000000-0000-0000-0000-000000000000"

# --- Funnel events ----------------------------------------------------------

# Where server-side events go: scorecard_viewed, analyze_deal_clicked,
# deal_activated, share_link_created, memo_generated, email_signup.
# Any endpoint that accepts a JSON POST works.
# EVENT_WEBHOOK_URL = "https://formspree.io/f/xxxxxxx"

# Events also print to stdout, which the Streamlit Cloud log viewer shows.
# Set to false to silence that.
# LOG_EVENTS = "true"

# --- Email capture ----------------------------------------------------------

# With this set, the footer collects addresses inline. Without it, the footer
# links to Substack instead. The address is POSTed here and is deliberately
# never included in an analytics event.
# EMAIL_SIGNUP_URL = "https://formspree.io/f/xxxxxxx"
